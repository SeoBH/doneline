PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=doneline_dev
PGUSER=doneline_app
PGPASSWORD=replace_locally
SESSION_SECRET=replace_with_at_least_32_random_characters
APP_ORIGIN=http://127.0.0.1:3100
PORT=3100

# 운영 알림용 슬랙 Incoming Webhook 주소(선택). 비우면 알림을 보내지 않는다.
SLACK_WEBHOOK_URL=

# 메일 발송(선택). SMTP_HOST를 비우면 메일을 보내지 않고 대기열에만 남긴다. Gmail은 README '메일 발송 설정' 참고.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cloudflare Pages 중계 표식(32자 이상, 운영 모드에서만 검사). scripts/deploy-pages.ps1 -Setup이 Pages에 같은 값을 등록한다.
PROXY_SECRET=
